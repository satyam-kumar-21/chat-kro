    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "mongoose": "8.24.6",
    "nodemailer": "10.1.7",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^5.10.0",
    "sanitize-html": "2.18.1",
